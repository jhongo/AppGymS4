<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppGymS4.Views.vResumen"
             Title="Resumen">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" />
    </Shell.BackButtonBehavior>
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PaginaLayout}">
                <Label x:Name="lblUsuarioConectado" Style="{StaticResource UsuarioConectado}" />
                

                <!-- 9 filas x 2 columnas -->
                <Border Style="{StaticResource Tarjeta}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" Style="{StaticResource FormGrid}">
                        <Label Grid.Row="0" Grid.Column="0" Text="Nombre" Style="{StaticResource EtiquetaCampo}" />
                        <Label Grid.Row="0" Grid.Column="1" x:Name="lblNombre" Style="{StaticResource ValorResumen}" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Apellido" Style="{StaticResource EtiquetaCampo}" />
                        <Label Grid.Row="1" Grid.Column="1" x:Name="lblApellido" Style="{StaticResource ValorResumen}" />

                        <Label Grid.Row="2" Grid.Column="0" Text="Edad" Style="{StaticResource EtiquetaCampo}" />
                        <Label Grid.Row="2" Grid.Column="1" x:Name="lblEdad" Style="{StaticResource ValorResumen}" />

                        <Label Grid.Row="3" Grid.Column="0" Text="Fecha de inicio" Style="{StaticResource EtiquetaCampo}" />
                        <Label Grid.Row="3" Grid.Column="1" x:Name="lblFechaInicio" Style="{StaticResource ValorResumen}" />

                        <Label Grid.Row="4" Grid.Column="0" Text="Plan" Style="{StaticResource EtiquetaCampo}" />
                        <Label Grid.Row="4" Grid.Column="1" x:Name="lblPlan" Style="{StaticResource ValorResumen}" />

                        <Label Grid.Row="5" Grid.Column="0" Text="Casillero" Style="{StaticResource EtiquetaCampo}" />
                        <Label Grid.Row="5" Grid.Column="1" x:Name="lblCasillero" Style="{StaticResource ValorResumen}" />

                        <Label Grid.Row="6" Grid.Column="0" Text="Monto Inicial" Style="{StaticResource EtiquetaCampo}" />
                        <Label Grid.Row="6" Grid.Column="1" x:Name="lblMontoInicial" Style="{StaticResource ValorResumen}" />

                        <Label Grid.Row="7" Grid.Column="0" Text="Pago mensual" Style="{StaticResource EtiquetaCampo}" />
                        <Label Grid.Row="7" Grid.Column="1" x:Name="lblPagoMensual" Style="{StaticResource ValorResumen}" />

                        <Label Grid.Row="8" Grid.Column="0" Text="Pago Total" Style="{StaticResource EtiquetaCampo}" />
                        <Label Grid.Row="8" Grid.Column="1" x:Name="lblPagoTotal" Style="{StaticResource ValorDestacado}" />
                    </Grid>
                </Border>

                <Button Text="Exportar resumen" Style="{StaticResource BotonPrincipal}" Clicked="btnExportarResumen_Clicked" />
                <Button Text="Cerrar sesión" Style="{StaticResource BotonSecundario}" Clicked="btnCerrarSesion_Clicked" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
