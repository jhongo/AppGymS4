<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppGymS4.Views.vLogin"
             Title="Login">
    <ContentPage.Content>
        <VerticalStackLayout Spacing="10" Padding="20">
            <Image Source="logo.png" />
            <Label Text="GIMNASIO - INICIO DE SESIÓN" />

            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*">
                <Label Grid.Row="0" Grid.Column="0" Text="Usuario" />
                <Entry Grid.Row="0" Grid.Column="1" x:Name="txtUsuario" Placeholder="Ingrese usuario" />

                <Label Grid.Row="1" Grid.Column="0" Text="Contraseña" />
                <Entry Grid.Row="1" Grid.Column="1" x:Name="txtContrasena" Placeholder="Ingrese contraseña" IsPassword="True" />

                <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Iniciar sesión" Clicked="btnIniciarSesion_Clicked" />
            </Grid>

            <Button Text="Acerca de" Clicked="btnAcercaDe_Clicked" />
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>
