<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppGymS4.Views.vLogin"
             Title="Inicio de Sesión">
    <Shell.TitleView>
        <Label Text="Inicio de Sesión" Style="{StaticResource TituloLogin}" VerticalOptions="Center" />
    </Shell.TitleView>
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PaginaLayout}">
                <Image Source="logo.png" Style="{StaticResource Logo}" />

                <Border Style="{StaticResource Tarjeta}">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" Style="{StaticResource FormGrid}">
                        <Label Grid.Row="0" Grid.Column="0" Text="Usuario" Style="{StaticResource EtiquetaCampo}" />
                        <Entry Grid.Row="0" Grid.Column="1" x:Name="txtUsuario" Placeholder="Ingrese usuario" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Contraseña" Style="{StaticResource EtiquetaCampo}" />
                        <Entry Grid.Row="1" Grid.Column="1" x:Name="txtContrasena" Placeholder="Ingrese contraseña" IsPassword="True" />

                        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="Iniciar sesión"
                                Style="{StaticResource BotonPrincipal}" Clicked="btnIniciarSesion_Clicked" />
                    </Grid>
                </Border>

                <Button Text="Acerca de" Style="{StaticResource BotonSecundario}" Clicked="btnAcercaDe_Clicked" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
