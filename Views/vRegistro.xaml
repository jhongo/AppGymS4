<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppGymS4.Views.vRegistro"
             Title="Registro">
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout Style="{StaticResource PaginaLayout}">
                <Label x:Name="lblUsuarioConectado" Style="{StaticResource UsuarioConectado}" />
                

                <!-- 2 filas x 3 columnas -->
                <Border Style="{StaticResource Tarjeta}">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*" Style="{StaticResource FormGrid}">
                        <Label Grid.Row="0" Grid.Column="0" Text="Nombre" Style="{StaticResource EtiquetaCampo}" />
                        <Label Grid.Row="0" Grid.Column="1" Text="Apellido" Style="{StaticResource EtiquetaCampo}" />
                        <Label Grid.Row="0" Grid.Column="2" Text="Edad" Style="{StaticResource EtiquetaCampo}" />

                        <Entry Grid.Row="1" Grid.Column="0" x:Name="txtNombre" Placeholder="Ingresar Nombre" />
                        <Entry Grid.Row="1" Grid.Column="1" x:Name="txtApellido" Placeholder="Ingresar Apellido" />
                        <Entry Grid.Row="1" Grid.Column="2" x:Name="txtEdad" Placeholder="Ingresar Edad" Keyboard="Numeric" />
                    </Grid>
                </Border>

                <!-- 5 filas x 2 columnas -->
                <Border Style="{StaticResource Tarjeta}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" Style="{StaticResource FormGrid}">
                        <Label Grid.Row="0" Grid.Column="0" Text="Fecha de inicio" Style="{StaticResource EtiquetaCampo}" />
                        <DatePicker Grid.Row="0" Grid.Column="1" x:Name="dpFechaInicio" />

                        <Label Grid.Row="1" Grid.Column="0" Text="Plan" Style="{StaticResource EtiquetaCampo}" />
                        <Picker Grid.Row="1" Grid.Column="1" x:Name="pkPlan" Title="Seleccione plan">
                            <Picker.Items>
                                <x:String>Musculación</x:String>
                                <x:String>Cardio</x:String>
                                <x:String>Crossfit</x:String>
                                <x:String>Full</x:String>
                            </Picker.Items>
                        </Picker>

                        <Label Grid.Row="2" Grid.Column="0" Text="Casillero" Style="{StaticResource EtiquetaCampo}" />
                        <Switch Grid.Row="2" Grid.Column="1" x:Name="swCasillero" HorizontalOptions="Start"
                                Toggled="swCasillero_Toggled" />

                        <Label Grid.Row="3" Grid.Column="0" Text="Monto Inicial" Style="{StaticResource EtiquetaCampo}" />
                        <Entry Grid.Row="3" Grid.Column="1" x:Name="txtMontoInicial" Placeholder="Entre 120 y 600" Keyboard="Numeric" />

                        <Button Grid.Row="4" Grid.Column="0" Text="Calcular Pago mensual"
                                Style="{StaticResource BotonSecundario}" Clicked="btnCalcular_Clicked" />
                        <Entry Grid.Row="4" Grid.Column="1" x:Name="txtPagoMensual" Placeholder="Pago mensual"
                               IsReadOnly="True" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Button Text="Ver Resumen" Style="{StaticResource BotonPrincipal}" Clicked="btnVerResumen_Clicked" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
