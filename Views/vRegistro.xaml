<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppGymS4.Views.vRegistro"
             Title="Registro">
    <ContentPage.Content>
        <ScrollView>
            <VerticalStackLayout>
                <Label x:Name="lblUsuarioConectado" />
                <Label Text="REGISTRO" />

                <!-- 2 filas x 3 columnas -->
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*,*">
                    <Label Grid.Row="0" Grid.Column="0" Text="Nombre" />
                    <Label Grid.Row="0" Grid.Column="1" Text="Apellido" />
                    <Label Grid.Row="0" Grid.Column="2" Text="Edad" />

                    <Entry Grid.Row="1" Grid.Column="0" x:Name="txtNombre" Placeholder="Ingresar Nombre" />
                    <Entry Grid.Row="1" Grid.Column="1" x:Name="txtApellido" Placeholder="Ingresar Apellido" />
                    <Entry Grid.Row="1" Grid.Column="2" x:Name="txtEdad" Placeholder="Ingresar Edad" Keyboard="Numeric" />
                </Grid>

                <!-- 5 filas x 2 columnas -->
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*">
                    <Label Grid.Row="0" Grid.Column="0" Text="Fecha de inicio" />
                    <DatePicker Grid.Row="0" Grid.Column="1" x:Name="dpFechaInicio" />

                    <Label Grid.Row="1" Grid.Column="0" Text="Plan" />
                    <Picker Grid.Row="1" Grid.Column="1" x:Name="pkPlan" Title="Seleccione plan">
                        <Picker.Items>
                            <x:String>Musculación</x:String>
                            <x:String>Cardio</x:String>
                            <x:String>Crossfit</x:String>
                            <x:String>Full</x:String>
                        </Picker.Items>
                    </Picker>

                    <Label Grid.Row="2" Grid.Column="0" Text="Casillero" />
                    <Switch Grid.Row="2" Grid.Column="1" x:Name="swCasillero" Toggled="swCasillero_Toggled" />

                    <Label Grid.Row="3" Grid.Column="0" Text="Monto Inicial" />
                    <Entry Grid.Row="3" Grid.Column="1" x:Name="txtMontoInicial" Placeholder="Entre 120 y 600" Keyboard="Numeric" />

                    <Button Grid.Row="4" Grid.Column="0" Text="Calcular Pago mensual" Clicked="btnCalcular_Clicked" />
                    <Entry Grid.Row="4" Grid.Column="1" x:Name="txtPagoMensual" Placeholder="Pago mensual" IsReadOnly="True" />
                </Grid>

                <Button Text="Ver Resumen" Clicked="btnVerResumen_Clicked" />
            </VerticalStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
